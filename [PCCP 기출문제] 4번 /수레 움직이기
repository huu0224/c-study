#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#define INF 999999

int N, M;
int rStart[2], bStart[2], rEnd[2], bEnd[2];
bool rVisited[4][4], bVisited[4][4];
int dy[] = {-1, 1, 0, 0};
int dx[] = {0, 0, -1, 1};
int min_answer;

// 수레가 목적지에 도착했는지 확인하는 함수
bool isRedArrived(int ry, int rx) { return ry == rEnd[0] && rx == rEnd[1]; }
bool isBlueArrived(int by, int bx) { return by == bEnd[0] && bx == bEnd[1]; }

void dfs(int ry, int rx, int by, int bx, int turn, int** maze) {
    // 두 수레가 모두 도착했다면 최솟값 갱신
    if (isRedArrived(ry, rx) && isBlueArrived(by, bx)) {
        if (turn < min_answer) min_answer = turn;
        return;
    }

    // 이미 찾은 최솟값보다 턴이 길어지면 가지치기
    if (turn >= min_answer) return;

    // 각 수레가 이동할 수 있는 다음 좌표 후보 계산
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            int nry = ry, nrx = rx, nby = by, nbx = bx;

            // 빨간 수레 이동 (도착하지 않은 경우만 움직임)
            if (!isRedArrived(ry, rx)) {
                nry = ry + dy[i];
                nrx = rx + dx[i];
            }
            // 파란 수레 이동 (도착하지 않은 경우만 움직임)
            if (!isBlueArrived(by, bx)) {
                nby = by + dy[j];
                nbx = bx + dx[j];
            }

            // --- 제약 조건 체크 ---
            // 1. 격자 범위 및 벽 체크
            if (nry < 0 || nry >= N || nrx < 0 || nrx >= M || (maze[nry][nrx] == 5 && !isRedArrived(ry, rx))) continue;
            if (nby < 0 || nby >= N || nbx < 0 || nbx >= M || (maze[nby][nbx] == 5 && !isBlueArrived(by, bx))) continue;

            // 2. 방문했던 칸 체크 (도착 지점 제외)
            if (!isRedArrived(ry, rx) && rVisited[nry][nrx]) continue;
            if (!isBlueArrived(by, bx) && bVisited[nby][nbx]) continue;

            // 3. 동시에 같은 칸으로 이동 불가
            if (nry == nby && nrx == nbx) continue;

            // 4. 서로 자리 바꾸기 불가
            if (nry == by && nrx == bx && nby == ry && nbx == rx) continue;

            // 이동 가능한 경우: 방문 처리 후 재귀 호출
            bool rUpdated = false, bUpdated = false;
            if (!isRedArrived(ry, rx)) { rVisited[nry][nrx] = true; rUpdated = true; }
            if (!isBlueArrived(by, bx)) { bVisited[nby][nbx] = true; bUpdated = true; }

            dfs(nry, nrx, nby, nbx, turn + 1, maze);

            // 백트래킹: 방문 처리 원상복구
            if (rUpdated) rVisited[nry][nrx] = false;
            if (bUpdated) bVisited[nby][nbx] = false;

            // 만약 수레가 고정된 상태라면 루프를 더 돌 필요 없음 (방향성 무의미)
            if (isBlueArrived(by, bx)) break; 
        }
        if (isRedArrived(ry, rx)) break;
    }
}

int solution(int** maze, size_t maze_rows, size_t maze_cols) {
    N = maze_rows;
    M = maze_cols;
    min_answer = INF;

    // 초기화 및 위치 파악
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            rVisited[i][j] = bVisited[i][j] = false;
            if (maze[i][j] == 1) { rStart[0] = i; rStart[1] = j; }
            else if (maze[i][j] == 2) { bStart[0] = i; bStart[1] = j; }
            else if (maze[i][j] == 3) { rEnd[0] = i; rEnd[1] = j; }
            else if (maze[i][j] == 4) { bEnd[0] = i; bEnd[1] = j; }
        }
    }

    // 시작 위치 방문 처리
    rVisited[rStart[0]][rStart[1]] = true;
    bVisited[bStart[0]][bStart[1]] = true;

    dfs(rStart[0], rStart[1], bStart[0], bStart[1], 0, maze);

    return (min_answer == INF) ? 0 : min_answer;
}
